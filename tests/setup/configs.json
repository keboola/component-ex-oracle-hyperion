  {
    "name": "07_run_essbase_incremental_with_state",
    "description": "Incremental custom query: no since/until in config — reads last_run=2024-01-01 from in/state.json, resolves dates via parse_datetime_interval, runs MDX, writes updated state",
    "config": {
      "action": "run",
      "parameters": {
        "hyperion_url": "http://34.31.58.133:9000",
        "username": "admin",
        "#password": "DUMMY_PASSWORD",
        "essbase_host": "34.31.58.133",
        "essbase_port": 9010,
        "ssl_verify": false,
        "use_ssl": false,
        "source": {
          "module": "essbase",
          "application": "Sample",
          "database": "Basic",
          "mdx_query": "SELECT {[Jan],[Feb],[Mar]} ON COLUMNS, {[100-10]} ON ROWS FROM [Sample.Basic]"
        },
        "destination": {
          "output_table": "essbase_incremental",
          "incremental": true
        }
      }
    }
  },
  {
    "name": "08_run_essbase_explicit_dates_substitution",
    "description": "Date substitution: explicit since=2024-01-01 / until=2024-03-31 — {{since}} and {{until}} placeholders in MDX comment are replaced before the query is sent to the server",
    "config": {
      "action": "run",
      "parameters": {
        "hyperion_url": "http://34.31.58.133:9000",
        "username": "admin",
        "#password": "DUMMY_PASSWORD",
        "essbase_host": "34.31.58.133",
        "essbase_port": 9010,
        "ssl_verify": false,
        "use_ssl": false,
        "source": {
          "module": "essbase",
          "application": "Sample",
          "database": "Basic",
          "mdx_query": "/* range: {{since}} to {{until}} */ SELECT {[Jan],[Feb],[Mar]} ON COLUMNS, {[Cola]} ON ROWS FROM [Sample.Basic]"
        },
        "destination": {
          "output_table": "essbase_explicit_dates",
          "since": "2024-01-01",
          "until": "2024-03-31",
          "incremental": true
        }
      }
    }
  },
  {
    "name": "09_run_essbase_relative_dates_substitution",
